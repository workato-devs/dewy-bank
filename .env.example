# Workato API token for the participant's workspace
WORKATO_API_TOKEN=<your-workato-api-token>

# Deployed bank app URL (CloudFront)
SPA_URL=https://<distribution>.cloudfront.net

# Support API key (from AWS SSM /dewybank/<workshopId>/support-api-key)
DEWY_SUPPORT_API_KEY=<support-api-key>

# MCP server URLs — copy each from the server's page in Workato after running setup_mcp_servers.py
# Format: https://<id>.apim.mcp.trial.workato.com/?wkt_token=<token>
A1=<paste StationA1 URL with token>
A2=<paste StationA2 URL with token>
B1=<paste StationB1 URL with token>
B2=<paste StationB2 URL with token>
C1=<paste StationC1 URL with token>
C2=<paste StationC2 Customer URL with token>
